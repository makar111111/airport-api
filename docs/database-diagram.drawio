        <mxCell id="airport" value="&lt;b&gt;Airport&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK  id: bigint&lt;br&gt;name: varchar(255)&lt;br&gt;closest_big_city: varchar(255)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#64748b;fontSize=15;">
